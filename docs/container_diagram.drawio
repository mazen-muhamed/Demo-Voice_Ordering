<mxfile host="app.diagrams.net"><diagram name="Container Diagram" id="cd1"><mxGraphModel dx="700" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="caller" value="&lt;b&gt;Caller&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;fontColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="180" height="44" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b&gt;FreeSWITCH (Docker)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SIP, RTP, ESL events&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="600" height="56" as="geometry"/></mxCell><mxCell id="afe" value="&lt;b&gt;Audio Front-end&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;VAD and barge-in&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="180" height="56" as="geometry"/></mxCell><mxCell id="asr" value="&lt;b&gt;ASR Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Speech to text&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="190" width="180" height="56" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Order JSON + reply&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontColor=#222222;stroke