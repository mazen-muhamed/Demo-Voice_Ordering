<include>
  <context name="default">

    <!-- The demo line.  CHANNEL_ANSWER is the trigger for listener.py to
         create the session and start mod_audio_stream; park keeps the media
         path open while the Pipecat pipeline drives the conversation. -->
    <extension name="voice_ordering_demo">
      <condition field="destination_number" expression="^5000$">
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- Media-path sanity check: dial 9196 and you should hear yourself. -->
    <extension name="echo_test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

  </context>
</include>
