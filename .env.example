# Copy to .env and fill in the values.  Never commit the filled file.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_demo
POSTGRES_HOST_PORT=5433
# Used when running the Python services directly on the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_demo

# --- FreeSWITCH -----------------------------------------------------------
FS_VERSION=1.10.12
# ESL password.  Simple value (letters/digits) — entrypoint.sh substitutes it
# into event_socket.conf.xml with sed.
FS_ESL_PASSWORD=ClueCon
# Optional: pin the advertised SIP/RTP IP (default: host default-route IP).
FS_LOCAL_IP=

# --- STT ------------------------------------------------------------------
# groq (demo) or local (faster-whisper, offline)
STT_BACKEND=groq
GROQ_API_KEY=

# --- TTS ------------------------------------------------------------------
# edge (Egyptian Arabic via edge-tts) or fake (0.5 s beep)
TTS_BACKEND=edge
EDGE_TTS_VOICE=ar-EG-SalmaNeural

# --- Services (host-run defaults) ----------------------------------------
SESSION_API_URL=http://127.0.0.1:8001/api/v1
VOICE_AGENT_WS_URL=ws://127.0.0.1:8765/ws
